{
  "name": "zk-proofscan",
  "version": "0.1.0",
  "description": "Experimental, unaudited. Checks zero-knowledge proofs, alone or found in Ethereum and Stellar transactions, with established verifiers, and reports what each establishes, what it does not, and what rests on network data.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OGtev317/ZK-Proofscan.git"
  },
  "homepage": "https://akashi.zatrix.xyz/",
  "keywords": [
    "zero-knowledge",
    "zk",
    "proof",
    "verifier",
    "groth16",
    "noir",
    "ultrahonk",
    "cairo",
    "risc-zero",
    "stellar",
    "soroban",
    "ethereum",
    "mcp"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "zk-proofscan": "dist/cli.js",
    "zk-proofscan-mcp": "dist/mcp.js",
    "stellar-zk-proofscan": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "artifacts",
    "!artifacts/aztec-crs/bn254_g1_compressed.dat",
    "!artifacts/aztec-crs/grumpkin_g1_v2.flat.dat",
    "!artifacts/aztec-crs/grumpkin_size",
    "adapters",
    "registry",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/DEVELOPERS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/make-fixture.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@aztec/bb.js": "5.2.1",
    "@noble/hashes": "2.4.0",
    "@stellar/js-xdr": "4.0.0",
    "@stellar/stellar-base": "15.0.0",
    "aztec-bb-js-0-87-0": "npm:@aztec/bb.js@0.87.0",
    "smol-toml": "1.9.0",
    "snarkjs": "0.7.6",
    "swiftness": "1.0.0",
    "viem": "2.57.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@noir-lang/noir_js": "1.0.0-rc.3",
    "@noir-lang/noir_wasm": "1.0.0-rc.3",
    "@playwright/test": "1.64.0",
    "@semaphore-protocol/group": "4.14.3",
    "@semaphore-protocol/identity": "4.14.3",
    "@semaphore-protocol/proof": "4.14.3",
    "@types/node": "26.6.5",
    "@types/snarkjs": "0.7.9",
    "noir-js-1-0-0-beta-9": "npm:@noir-lang/noir_js@1.0.0-beta.9",
    "noir-wasm-1-0-0-beta-9": "npm:@noir-lang/noir_wasm@1.0.0-beta.9",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "overrides": {
    "ws": "8.21.0"
  }
}
