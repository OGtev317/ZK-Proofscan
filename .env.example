# Copy to .env (which Git ignores) and fill in. Never commit a real key.
# Used only by `lumenlenz lookup` and the lookup_transaction tool.
ALCHEMY_API_KEY=
# Or a full JSON-RPC address for any provider, used as given:
# LUMENLENZ_RPC_URL=
# For stellar-testnet, a Stellar RPC address; without one the public testnet RPC is used:
# STELLAR_RPC_URL=
# For stellar-mainnet, the RPC you choose; there is no default. Public ones
# are listed at https://developers.stellar.org/docs/data/apis/rpc/providers
# STELLAR_MAINNET_RPC_URL=
# Optional explicit fallback providers. Never used unless configured:
# STELLAR_ARCHIVE_RPC_URL=
# STELLAR_MAINNET_ARCHIVE_RPC_URL=
