# Copy to .env (which Git ignores) and fill in. Never commit a real key.
# Used only by `zk-proofscan lookup` and the lookup_transaction tool.
ALCHEMY_API_KEY=
# Or a full JSON-RPC address for any provider, used as given:
# ZK_PROOFSCAN_RPC_URL=
# For stellar-testnet, a Stellar RPC address; without one the public testnet RPC is used:
# STELLAR_RPC_URL=
